# Which LLM provider the chat agent runs on: "openai" (default) or "groq".
LLM_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
# Optional. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=groq. Groq's free/on-demand tier has a low
# shared tokens-per-minute cap and some models there are unreliable at real
# tool-calling — openai/gpt-oss-120b is the one that's been verified to work.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. If unset, falls back to a local SQLite file (backend/data/hotel_ops.db).
# Railway's Postgres plugin injects this automatically as postgres://...
