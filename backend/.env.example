GROQ_API_KEY=your_groq_api_key_here

# Optional. Defaults to llama-3.3-70b-versatile if unset, but that model has
# been unreliable at real tool-calling on Groq (silently echoes the tool call
# as text, or 400s with "Failed to call a function"). openai/gpt-oss-120b
# calls tools correctly and is what production uses.
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. If unset, falls back to a local SQLite file (backend/data/hotel_ops.db).
# Railway's Postgres plugin injects this automatically as postgres://...

